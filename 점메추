import random

menu_list = ["김치찌개", "돈까스", "초밥", "햄버거", "마라탕", "쌀국수", "제육볶음", "파스타"]

def pick_lunch():
    print("---  제외 메뉴 기능이 추가된 추천기 ---")
    print(f"현재 전체 후보: {', '.join(menu_list)}")
    
    # 1. 제외할 메뉴 입력받기
    exclude = input("안 당기는 메뉴 하나를 입력하세요 (없으면 그냥 엔터): ").strip()
    
    # 2. 제외 처리 
    current_menu = menu_list.copy()
    
    if exclude in current_menu:
        current_menu.remove(exclude)
        print(f" '{exclude}'(을)를 제외하고 추천해 드릴게요.")
    elif exclude == "":
        print(" 모든 메뉴를 후보로 사용합니다.")
    else:
        print(f" '{exclude}'(은)는 원래 목록에 없네요. 전체에서 뽑을게요!")

    # 3. 최종 선택
    choice = random.choice(current_menu)
    print("\n" + "="*30)
    print(f" 오늘의 추천 메뉴: [ {choice} ]")
    print("="*30)

# 함수 실행
pick_lunch()
