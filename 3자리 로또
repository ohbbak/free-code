import random

def generate_lotto():
    # 1부터 45까지의 숫자 중 중복 없이 3개를 무작위로 선택
    lotto_numbers = random.sample(range(1, 46), 3)
    
    # 보기 좋게 오름차순으로 정렬
    lotto_numbers.sort()
    
    return lotto_numbers

# 코드 실행 및 결과 출력
print("=== 🍀 행운의 3자리 로또 번호 === ")
numbers = generate_lotto()
print(f"오늘의 번호: {numbers[0]}, {numbers[1]}, {numbers[2]}")
print("================================")
