import java.util.*;

public class JavaGame {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int target = new Random().nextInt(100) + 1;
        int guess = 0, count = 0;

        System.out.println("1~100 사이 숫자를 맞춰보세요!");

        while (guess != target) {
            System.out.print("입력: ");
            
            if (!sc.hasNextInt()) { // 숫자가 아니면
                System.out.println("숫자만 입력 가능!");
                sc.next(); continue;
            }

            guess = sc.nextInt();
            count++;

            if (guess == target) {
                System.out.println("정답! " + count + "번 만에 성공!");
            } else {
                // 삼항 연산자로 메시지를 한 줄로 처리
                System.out.println(guess < target ? "UP ↑" : "DOWN ↓");
            }
        }
        sc.close();
    }
}
