import java.util.Scanner;
import java.util.Random;

public class JavaGame {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Random random = new Random();
        
        int targetNumber = random.nextInt(100) + 1; // 1~100 사이 난수
        int attempts = 0;
        int guess = 0;
        
        System.out.println("=== 자바 숫자 맞추기 게임 ===");
        System.out.println("1부터 100 사이의 숫자를 맞춰보세요!");

        // 게임 루프
        while (guess != targetNumber) {
            System.out.print("숫자 입력: ");
            
            // 입력이 숫자인지 확인 (파이썬의 isdigit 역할)
            if (scanner.hasNextInt()) {
                guess = scanner.nextInt();
                attempts++;

                if (guess < targetNumber) {
                    System.out.println(" UP! 더 큰 숫자입니다.");
                } else if (guess > targetNumber) {
                    System.out.println(" DOWN! 더 작은 숫자입니다.");
                } else {
                    System.out.println(" 정답입니다! " + attempts + "번 만에 맞추셨네요!");
                }
            } else {
                System.out.println(" 숫자가 아닙니다! 다시 입력하세요.");
                scanner.next(); // 잘못된 입력 버리기
            }
        }
        
        scanner.close();
        System.out.println("게임을 종료합니다.");
    }
}
