import turtle
import colorsys

t = turtle.Turtle()
s = turtle.Screen()
s.bgcolor("black")  
t.speed(0)          

n = 36             
h = 0               

print("거북이가 예술 작품을 그리는 중입니다 창을 확인!") # 출력

for i in range(400):

    c = colorsys.hsv_to_rgb(h, 1, 0.8)
    h += 1/n
    t.color(c)
    

    t.forward(i * 1.5)
    t.left(59)      
    t.width(i/100 + 1)

turtle.done()
